<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/kids_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/btnChatBack"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/ripple_dark"
            android:background="@drawable/shape_circle_white"
            android:layout_width="52dp"
            android:layout_height="52dp">

            <TextView
                android:text="🔙"
                android:textSize="24sp"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </FrameLayout>

        <ImageView
            android:id="@+id/ivChatPeerAvatar"
            android:src="@drawable/av_bear"
            android:layout_marginStart="10dp"
            android:layout_width="40dp"
            android:layout_height="40dp" />

        <TextView
            android:id="@+id/tvChatPeer"
            android:text="💬 对话对象"
            android:textSize="15sp"
            android:textColor="@color/kids_text"
            android:layout_marginStart="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:background="@drawable/shape_card_white"
        android:padding="8dp" />

    <!-- 四个快捷按钮：表情 / 照片 / 拍照 / 语音 -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/btnEmoji"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_light"
                android:background="@drawable/shape_circle_yellow"
                android:layout_width="58dp"
                android:layout_height="58dp">

                <TextView
                    android:text="😊"
                    android:textSize="28sp"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </FrameLayout>

            <TextView
                android:text="表情"
                android:textSize="12sp"
                android:textColor="@color/kids_text_sub"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/btnPhoto"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_light"
                android:background="@drawable/shape_circle_blue"
                android:layout_width="58dp"
                android:layout_height="58dp">

                <TextView
                    android:text="📷"
                    android:textSize="28sp"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </FrameLayout>

            <TextView
                android:text="照片"
                android:textSize="12sp"
                android:textColor="@color/kids_text_sub"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/btnCamera"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_light"
                android:background="@drawable/shape_circle_pink"
                android:layout_width="58dp"
                android:layout_height="58dp">

                <TextView
                    android:text="📸"
                    android:textSize="28sp"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </FrameLayout>

            <TextView
                android:text="拍照"
                android:textSize="12sp"
                android:textColor="@color/kids_text_sub"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/btnVoiceMsg"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_light"
                android:background="@drawable/shape_circle_green"
                android:layout_width="58dp"
                android:layout_height="58dp">

                <TextView
                    android:id="@+id/tvVoiceIcon"
                    android:text="🎤"
                    android:textSize="28sp"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvVoiceLabel"
                android:text="按住说话"
                android:textSize="12sp"
                android:textColor="@color/kids_text_sub"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/etInput"
            android:hint="想说点什么…"
            android:textSize="16sp"
            android:inputType="text"
            android:textColorHint="@color/kids_text_sub"
            android:textColor="@color/kids_text"
            android:background="@drawable/shape_input"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:id="@+id/btnSend"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/ripple_light"
            android:background="@drawable/shape_pill_pink"
            android:layout_marginStart="10dp"
            android:layout_width="96dp"
            android:layout_height="52dp">

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:text="📨"
                    android:textSize="20sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="发送"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
