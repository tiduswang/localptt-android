<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/kids_bg">

    <LinearLayout
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/btnGameBack"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_dark"
                android:background="@drawable/shape_circle_white"
                android:layout_width="52dp"
                android:layout_height="52dp">

                <TextView
                    android:text="🔙"
                    android:textSize="24sp"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </FrameLayout>

            <ImageView
                android:id="@+id/ivGamePeerAvatar"
                android:src="@drawable/av_bear"
                android:layout_marginStart="10dp"
                android:layout_width="40dp"
                android:layout_height="40dp" />

            <TextView
                android:id="@+id/tvGamePeer"
                android:text="🧒 对手：还没选"
                android:textSize="15sp"
                android:textColor="@color/kids_text"
                android:layout_marginStart="10dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvLink"
                android:text="📶 我 — ｜ 对方 —"
                android:textSize="12sp"
                android:textColor="@color/kids_text_sub"
                android:gravity="end"
                android:layout_marginStart="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 结果大卡 -->
        <FrameLayout
            android:layout_marginTop="12dp"
            android:background="@drawable/shape_card_white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvGameResult"
                    android:text="🏆 还没开始"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:minLines="2"
                    android:textColor="@color/kids_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tvGameStatus"
                    android:text="选一个游戏，叫小伙伴一起玩"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:textColor="@color/kids_text_sub"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:text="🎯 选游戏"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/kids_text"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/btnInviteRps"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_light"
                android:background="@drawable/shape_card_orange"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="86dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:text="✊"
                        android:textSize="32sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:text="猜  拳"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnInviteDice"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_light"
                android:background="@drawable/shape_card_purple"
                android:layout_marginStart="12dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="86dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:text="🎲"
                        android:textSize="32sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:text="掷骰子"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:text="✊✌️✋ 出 招"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/kids_text"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="vertical"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:id="@+id/btnRock"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/ripple_light"
                    android:background="@drawable/shape_circle_red"
                    android:layout_width="84dp"
                    android:layout_height="84dp">

                    <TextView
                        android:text="✊"
                        android:textSize="38sp"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </FrameLayout>

                <TextView
                    android:text="石头"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/kids_text"
                    android:layout_marginTop="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:id="@+id/btnScissors"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/ripple_light"
                    android:background="@drawable/shape_circle_blue"
                    android:layout_width="84dp"
                    android:layout_height="84dp">

                    <TextView
                        android:text="✌️"
                        android:textSize="38sp"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </FrameLayout>

                <TextView
                    android:text="剪刀"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/kids_text"
                    android:layout_marginTop="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:id="@+id/btnPaper"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/ripple_light"
                    android:background="@drawable/shape_circle_green"
                    android:layout_width="84dp"
                    android:layout_height="84dp">

                    <TextView
                        android:text="✋"
                        android:textSize="38sp"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </FrameLayout>

                <TextView
                    android:text="布"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/kids_text"
                    android:layout_marginTop="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnDiceRoll"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/ripple_light"
            android:background="@drawable/shape_pill_orange"
            android:layout_marginTop="18dp"
            android:layout_width="match_parent"
            android:layout_height="64dp">

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:text="🎲"
                    android:textSize="30sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="掷骰子（比谁大）"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:text="🔒 小秘密：出招会先藏起来，两边都出好了才一起打开，谁也赖不了皮 😄"
            android:textSize="12sp"
            android:textColor="@color/kids_text_sub"
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
