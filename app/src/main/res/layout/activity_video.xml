<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/videoRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/videoContent"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/kids_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/videoTopBar"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/btnVideoBack"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/ripple_light"
                android:background="@drawable/shape_circle_red"
                android:layout_width="52dp"
                android:layout_height="52dp">

                <TextView
                    android:text="📞"
                    android:textSize="24sp"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </FrameLayout>

            <TextView
                android:text="挂断"
                android:textSize="14sp"
                android:textColor="@color/kids_text"
                android:layout_marginStart="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvVideoStatus"
                android:text="🕐 等小伙伴一起看"
                android:textSize="15sp"
                android:textColor="@color/kids_text"
                android:layout_marginStart="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 画面舞台：小伙伴的画面铺满，自己的画面永远浮在左上角（画中画） -->
        <FrameLayout
            android:id="@+id/videoStage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:background="@drawable/shape_screen">

            <TextureView
                android:id="@+id/remoteView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <TextView
                android:id="@+id/tvRemoteTag"
                android:text="🧒 这是小伙伴"
                android:textSize="12sp"
                android:textColor="#FFE9C7"
                android:background="#66000000"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <FrameLayout
                android:id="@+id/localCard"
                android:layout_width="104dp"
                android:layout_height="148dp"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/shape_screen"
                android:elevation="6dp">

                <TextureView
                    android:id="@+id/localPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

                <TextView
                    android:text="🙋 你"
                    android:textSize="11sp"
                    android:textColor="#FFE9C7"
                    android:background="#66000000"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_gravity="bottom|start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </FrameLayout>
        </FrameLayout>

        <!-- 画面控制：转画面 / 横竖屏 / 全屏 -->
        <LinearLayout
            android:id="@+id/videoToolBar"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/btnRotate"
                android:text="↻ 转画面"
                android:textSize="15sp"
                android:textColor="@color/kids_text"
                android:background="@drawable/shape_pill_gray"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="10dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/btnOrientation"
                android:text="🔁 横屏"
                android:textSize="15sp"
                android:textColor="@color/kids_text"
                android:background="@drawable/shape_pill_gray"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="10dp"
                android:layout_marginStart="8dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/btnFullscreen"
                android:text="⛶ 全屏"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/shape_pill_blue"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="10dp"
                android:layout_marginStart="8dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 麦克风开关 + 邀请 -->
        <LinearLayout
            android:id="@+id/videoBottomBar"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/btnMic"
                android:text="🎤 麦克风：开"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/shape_pill_green"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="14dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/btnInvite"
                android:text="📹 邀请小伙伴"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/shape_pill_orange"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="14dp"
                android:layout_marginStart="10dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
